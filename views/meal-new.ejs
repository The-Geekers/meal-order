<%- include('partials/head') %><%- include('partials/header') %><main class="container"><section class="intro"><div><div class="kicker">Nouveau service</div><h1>Créer un repas</h1></div><p>Choisis les personnes réellement présentes pour avoir un compteur fiable.</p></section><form method="post" action="/admin/meals"><div class="panel"><div class="field"><label>Nom du repas</label><input name="title" placeholder="Dimanche midi — Event" required></div></div><div class="sectionbar"><strong>Personnes présentes</strong><button class="btn light" type="button" data-check-all="#people-form">Tout sélectionner</button></div><div class="panel" id="people-form"><div class="checks"><% people.forEach(p=>{ %><label class="check"><input type="checkbox" name="people" value="<%= p.id %>" checked><span><%= p.name %></span></label><% }) %></div></div><div class="actions"><button class="btn">Créer le repas</button><a class="btn light" href="/admin">Annuler</a></div></form></main><%- include('partials/footer') %>
