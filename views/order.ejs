<%- include('partials/head') %><%- include('partials/header') %><main class="order-shell"><form class="order-card" method="post" action="/o/<%= person.token %>"><div class="order-title"><div class="kicker"><%= meal.title %></div><h1>Bonjour <%= person.name %></h1></div><% if(saved){ %><div class="saved">Commande enregistrée. Tu peux encore la modifier tant que les commandes restent ouvertes.</div><% } %><% categories.forEach(c=>{ %><section class="choice-section"><h2><%= c.name %></h2><div class="hint"><%= c.max_choices===1?'Choisis une option.':'Jusqu’à '+c.max_choices+' choix.' %></div><div class="choice-grid"><% c.items.forEach(i=>{ const type=c.max_choices===1?'radio':'checkbox'; %><div class="choice"><input id="item_<%= i.id %>" type="<%= type %>" name="cat_<%= c.id %>" value="<%= i.id %>" <%= selected.includes(i.id)?'checked':'' %>><label for="item_<%= i.id %>"><%= i.name %></label></div><% }) %></div></section><% }) %><div class="order-submit"><button class="btn" type="submit">Valider ma commande</button></div></form></main>

</body></html>
