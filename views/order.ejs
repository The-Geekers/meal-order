<%- include('partials/head') %><%- include('partials/header') %><main class="order-shell"><form class="order-card" method="post" action="/o/<%= person.token %>"><div class="order-title"><div class="kicker"><%= meal.title %></div><h1>Bonjour <%= person.name %></h1></div><% if(saved){ %><div class="saved">Commande enregistrée. Tu peux encore la modifier tant que les commandes restent ouvertes.</div><% } %><% categories.forEach(c=>{ const current=c.items.find(i=>selected.includes(i.id)); %><section class="choice-section"><h2><%= c.name %></h2><div class="hint">Un seul choix dans cette catégorie.</div><div class="choice-grid"><div class="choice"><input id="none_<%= c.id %>" type="radio" name="cat_<%= c.id %>" value="" <%= current?'':'checked' %>><label for="none_<%= c.id %>">Aucun</label></div><% c.items.forEach(i=>{ %><div class="choice"><input id="item_<%= i.id %>" type="radio" name="cat_<%= c.id %>" value="<%= i.id %>" <%= selected.includes(i.id)?'checked':'' %>><label for="item_<%= i.id %>"><%= i.name %></label></div><% }) %></div></section><% }) %><div class="order-submit"><button class="btn" type="submit">Valider ma commande</button></div></form></main>
</body></html>
