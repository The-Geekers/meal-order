<%- include('partials/head') %><%- include('partials/header') %><main class="container"><section class="intro"><div><div class="kicker">Exploitation</div><h1>Commandes repas</h1></div><p>Prépare le menu, ouvre les commandes et suis les réponses en temps réel.</p></section><% if(meal){ %><div class="meta-grid" data-watch-meal="<%= meal.id %>"><div class="meta-box"><strong><span data-stat="answered"><%= stats.answered %></span>/<span data-stat="total"><%= stats.total %></span></strong><span>Réponses</span></div><div class="meta-box"><strong data-stat="missing"><%= stats.missing %></strong><span>À relancer</span></div><div class="meta-box"><strong><%= meal.status.toUpperCase() %></strong><span><%= meal.title %></span></div><div class="meta-box"><strong data-stat="distributed"><%= stats.distributed %></strong><span>Distribués</span></div></div><% } %><div class="admin-grid"><a class="admin-card" style="--card:#191919" href="/admin/people"><span class="symbol">01</span><h2>Équipe</h2><p>Personnes présentes et liens personnels.</p></a><a class="admin-card" style="--card:#e9471d" href="/admin/meals/new"><span class="symbol">02</span><h2>Nouveau repas</h2><p>Créer un service et sélectionner les présents.</p></a><% if(meal){ %><a class="admin-card" style="--card:#a08d16" href="/admin/meals/<%= meal.id %>/edit"><span class="symbol">03</span><h2>Menu</h2><p>Catégories, plats, boissons et ouverture.</p></a><a class="admin-card" style="--card:#44745b" href="/admin/meals/<%= meal.id %>/recap"><span class="symbol">04</span><h2>Récap</h2><p>Quantités fournisseur et distribution.</p></a><% } %></div><div class="sectionbar"><strong>Historique</strong><span><%= meals.length %> service(s)</span></div><div class="panel"><table><thead><tr><th>Repas</th><th>Statut</th><th>Créé</th><th></th></tr></thead><tbody><% meals.forEach(m=>{ %><tr><td><strong><%= m.title %></strong></td><td><span class="badge <%= m.status==='open'?'ok':m.status==='closed'?'off':'' %>"><%= m.status %></span></td><td><%= m.created_at %></td><td><a class="btn light" href="/admin/meals/<%= m.id %>/recap">Ouvrir</a></td></tr><% }) %><% if(!meals.length){ %><tr><td colspan="4" class="muted">Aucun repas créé.</td></tr><% } %></tbody></table></div></main><%- include('partials/footer') %>
