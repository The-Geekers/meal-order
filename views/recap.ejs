<%- include('partials/head') %><%- include('partials/header') %><main class="container" data-watch-meal="<%= meal.id %>"><section class="intro"><div><div class="kicker">Temps réel · <span class="status-<%= meal.status %>"><%= meal.status %></span></div><h1><%= meal.title %></h1></div><p>Vue fournisseur agrégée et distribution nominative.</p></section><div class="meta-grid"><div class="meta-box"><strong><span data-stat="answered"><%= stats.answered %></span>/<span data-stat="total"><%= stats.total %></span></strong><span>Réponses</span></div><div class="meta-box"><strong data-stat="missing"><%= stats.missing %></strong><span>Manquants</span></div><div class="meta-box"><strong data-stat="distributed"><%= stats.distributed %></strong><span>Distribués</span></div><div class="meta-box"><strong><%= meal.status.toUpperCase() %></strong><span>État</span></div></div><div class="actions"><a class="btn secondary" href="/admin/meals/<%= meal.id %>/edit">Menu</a><% if(meal.status==='draft'){ %><form method="post" action="/admin/meals/<%= meal.id %>/status"><input type="hidden" name="status" value="open"><button class="btn success">Ouvrir</button></form><% } %><% if(meal.status==='open'){ %><form method="post" action="/admin/meals/<%= meal.id %>/status"><input type="hidden" name="status" value="closed"><button class="btn danger">Fermer</button></form><% } %></div><div class="recap-grid"><section class="panel"><h2>À commander</h2><table><thead><tr><th>Catégorie</th><th>Produit</th><th>Qté</th></tr></thead><tbody data-live-aggregate><% agg.forEach(r=>{ %><tr><td><%= r.category %></td><td><%= r.item %></td><td><strong>× <%= r.qty %></strong></td></tr><% }) %><% if(!agg.length){ %><tr><td colspan="3" class="muted">Aucune commande.</td></tr><% } %></tbody></table><div class="actions"><button class="btn secondary" type="button" data-copy="#supplier-text">Copier la commande</button></div><pre id="supplier-text" class="supplier-text"><%= supplierText %></pre></section><section class="panel"><h2>Accès équipe</h2><div class="qr-box"><img src="<%= qr %>" alt="QR commande"><div><div class="linkline"><%= generalUrl %></div><p class="muted">QR général : chacun sélectionne son nom.</p></div></div></section></div><div class="sectionbar"><strong>Personnes sans réponse</strong><span><%= stats.missing %></span></div><div class="panel missing" data-live-missing><% people.filter(p=>!p.order_id).forEach(p=>{ %><span><%= p.name %></span><% }) %><% if(!stats.missing){ %><span class="badge ok">Tout le monde a répondu</span><% } %></div><div class="sectionbar" id="distribution"><strong>Distribution</strong><span>Cliquer quand remis</span></div><div class="panel"><table><thead><tr><th>Personne</th><th>Commande</th><th>État</th><th></th></tr></thead><tbody data-live-distribution><% orders.forEach(o=>{ %><tr class="distribution-row <%= o.distributed_at?'done':'' %>"><td><strong><%= o.name %></strong></td><td><%= o.choices.map(x=>x.item).join(' · ') || '—' %></td><td><span class="badge <%= o.distributed_at?'ok':'' %>"><%= o.distributed_at?'remis':'à remettre' %></span></td><td><form method="post" action="/admin/orders/<%= o.order_id %>/distributed"><button class="btn <%= o.distributed_at?'light':'success' %>"><%= o.distributed_at?'Annuler':'Remis' %></button></form></td></tr><% }) %></tbody></table></div></main><%- include('partials/footer') %>
