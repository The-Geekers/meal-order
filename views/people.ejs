<%- include('partials/head') %><%- include('partials/header') %><main class="container"><section class="intro"><div><div class="kicker">Administration</div><h1>Équipe</h1></div><p>Chaque personne conserve le même lien personnel d’un event à l’autre.</p></section><div class="panel"><h2>Ajouter une personne</h2><form class="inline-form" method="post" action="/admin/people"><input name="name" placeholder="Prénom / nom" required><button class="btn">Ajouter</button></form></div><div class="people-list"><% people.forEach(p=>{ %><div class="person-row"><div><div class="person-name"><%= p.name %> <span class="badge <%= p.active?'ok':'off' %>"><%= p.active?'actif':'inactif' %></span></div><div class="linkline"><%= baseUrl %>/o/<%= p.token %></div></div><div class="tiny-actions"><form method="post" action="/admin/people/<%= p.id %>/toggle"><button class="btn light"><%= p.active?'Désactiver':'Activer' %></button></form><form method="post" action="/admin/people/<%= p.id %>/token"><button class="btn secondary">Nouveau lien</button></form></div></div><% }) %></div></main><%- include('partials/footer') %>
