<%- include('partials/head') %><%- include('partials/header') %><main class="container"><section class="intro"><div><div class="kicker">Menu · <%= meal.status %></div><h1><%= meal.title %></h1></div><p>Le menu n’est éditable qu’en brouillon. Une fois ouvert, les choix sont figés.</p></section><div class="actions"><a class="btn secondary" href="/admin/meals/<%= meal.id %>/recap">Voir le récap</a><% if(meal.status==='draft'){ %><form method="post" action="/admin/meals/<%= meal.id %>/status"><input type="hidden" name="status" value="open"><button class="btn success">Ouvrir les commandes</button></form><% } else if(meal.status==='open'){ %><form method="post" action="/admin/meals/<%= meal.id %>/status"><input type="hidden" name="status" value="closed"><button class="btn danger">Fermer les commandes</button></form><% } %></div><div class="sectionbar"><strong>Catégories</strong><span>1 choix par défaut</span></div><% categories.forEach(c=>{ %><section class="category-card"><div class="category-head"><h3><%= c.name %> · max <%= c.max_choices %></h3><% if(meal.status==='draft'){ %><form method="post" action="/admin/categories/<%= c.id %>/delete"><button class="btn danger">Supprimer</button></form><% } %></div><div class="item-list"><% c.items.forEach(i=>{ %><div class="item-row"><span><%= i.name %></span><% if(meal.status==='draft'){ %><form method="post" action="/admin/items/<%= i.id %>/delete"><button class="btn light">×</button></form><% } %></div><% }) %><% if(!c.items.length){ %><div class="muted">Aucun choix.</div><% } %></div><% if(meal.status==='draft'){ %><form class="inline-form" method="post" action="/admin/categories/<%= c.id %>/items"><input name="name" placeholder="Ajouter : Coca, Merguez, Café…" required><button class="btn">Ajouter</button></form><% } %></section><% }) %><% if(meal.status==='draft'){ %><div class="panel"><h2>Ajouter une catégorie</h2><form class="form-grid" method="post" action="/admin/meals/<%= meal.id %>/categories"><div class="field"><label>Nom</label><input name="name" placeholder="Plat / Boisson froide / Dessert" required></div><div class="field"><label>Choix maximum</label><input type="number" min="1" max="10" name="max_choices" value="1"></div><div class="actions"><button class="btn">Ajouter la catégorie</button></div></form></div><div class="sectionbar"><strong>Présents</strong><span><%= assigned.size %> sélectionné(s)</span></div><form class="panel" method="post" action="/admin/meals/<%= meal.id %>/people"><div class="checks"><% allPeople.forEach(p=>{ %><label class="check"><input type="checkbox" name="people" value="<%= p.id %>" <%= assigned.has(p.id)?'checked':'' %>><span><%= p.name %></span></label><% }) %></div><div class="actions"><button class="btn">Enregistrer les présents</button></div></form><% } %></main><%- include('partials/footer') %>
